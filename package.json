{
  "name": "@fusedashlabs/ui9000-workspace",
  "version": "0.4.5",
  "type": "module",
  "description": "UI9000 workspace MCP. One tool, show_workspace, draws a chart from your table. Set TYPESAFE_API_KEY to let Jev choose the chart.",
  "license": "Apache-2.0",
  "bin": {
    "ui9000-workspace": "./bin/ui9000-workspace-server.mjs",
    "ui9000-workspace-server": "./bin/ui9000-workspace-server.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "node ./bin/ui9000-workspace-server.mjs",
    "start:http": "node ./bin/ui9000-workspace-server.mjs --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn typecheck && yarn test && yarn build",
    "scorecard": "tsx scripts/scorecard.ts",
    "scorecard:check": "tsx scripts/scorecard.ts --check",
    "secret-scan": "node scripts/secret-scan.mjs",
    "pack:check": "node scripts/assert-pack.mjs"
  },
  "dependencies": {
    "@fusedashlabs/widgets": "0.7.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.0",
    "js-tiktoken": "^1.0.21",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fusedashlabs/ui9000-core.git"
  },
  "homepage": "https://github.com/fusedashlabs/ui9000-core",
  "bugs": {
    "url": "https://github.com/fusedashlabs/ui9000-core/issues"
  },
  "keywords": [
    "mcp",
    "ui9000",
    "fusedash",
    "show_workspace",
    "cursor",
    "claude"
  ],
  "packageManager": "yarn@4.5.0"
}
