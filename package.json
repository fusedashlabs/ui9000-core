{
  "name": "@fusedashlabs/ui9000-workspace",
  "version": "0.1.3",
  "type": "module",
  "description": "UI9000 workspace MCP — one tool, show_workspace. For Cursor and Claude. FuseDash client keeps using mcp-ui.",
  "license": "Apache-2.0",
  "bin": {
    "ui9000-workspace": "./bin/ui9000-workspace-server.mjs",
    "ui9000-workspace-server": "./bin/ui9000-workspace-server.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node ./bin/ui9000-workspace-server.mjs",
    "start:http": "node ./bin/ui9000-workspace-server.mjs --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn typecheck && yarn test",
    "scorecard": "tsx scripts/scorecard.ts",
    "scorecard:check": "tsx scripts/scorecard.ts --check"
  },
  "dependencies": {
    "@fusedashlabs/widgets": "0.5.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "tsx": "^4.23.13",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.0",
    "js-tiktoken": "^1.0.21",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fusedashlabs/ui9000-core.git"
  },
  "homepage": "https://github.com/fusedashlabs/ui9000-core",
  "bugs": {
    "url": "https://github.com/fusedashlabs/ui9000-core/issues"
  },
  "keywords": [
    "mcp",
    "ui9000",
    "fusedash",
    "show_workspace",
    "cursor",
    "claude"
  ],
  "packageManager": "yarn@4.5.0"
}
